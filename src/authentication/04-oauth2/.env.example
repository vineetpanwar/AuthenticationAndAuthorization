# Google OAuth 2.0 Credentials
# Obtain these from https://console.cloud.google.com/
# 1. Create a new project (or select existing)
# 2. Navigate to APIs & Services > Credentials
# 3. Create OAuth 2.0 Client ID (Web application)
# 4. Add authorized redirect URI: http://localhost:3004/auth/google/callback

GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# Callback URL (must match the one configured in Google Console)
CALLBACK_URL=http://localhost:3004/auth/google/callback

# Session secret (use a long random string in production)
SESSION_SECRET=change-this-to-a-random-secret-in-production
